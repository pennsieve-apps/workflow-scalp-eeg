{
 "name": "Scalp EEG Interictal Biomarkers",
 "summary": "Scalp EEG: spectral biomarkers, PDR, spikes by sleep stage, sleep, connectivity, report.",
 "description": "Interictal biomarkers of clinical scalp EEG for epilepsy and neurology research. Prepares the recordings (canonical 10-20 channels, bad channels, filters, average reference, ICA + ICLabel artifact removal; BIDS-EEG or clinical formats), then computes spectral biomarkers (band power, aperiodic exponent with specparam, posterior dominant rhythm, revised Brain Symmetry Index, slowing), sleep staging with spindles and slow waves (YASA), interictal spike candidates with rates per sleep stage (epycom detectors, validated on intracranial EEG and labelled as a baseline on scalp EEG), and sensor-space connectivity (wPLI, imaginary coherence, envelope correlation), and writes an HTML/PDF report with every method's caveats. Research use only; outputs are to be reviewed against the EEG, not clinical findings.",
 "inputs": [
  {
   "id": "eeg",
   "name": "Scalp EEG recordings",
   "description": "Clinical scalp EEG (routine or long-term): a BIDS-EEG dataset (HED-SCORE seizure events read), or EDF/EDF+, BDF, BrainVision, EEGLAB, FIF, Nihon Kohden or Natus recordings, plus optional CHB-MIT-style summary files or a labels.csv with annotated seizures.",
   "position": {
    "x": 40,
    "y": 300
   }
  }
 ],
