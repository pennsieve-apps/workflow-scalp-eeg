{
 "name": "Scalp EEG Seizure Detection & Monitoring",
 "summary": "Scalp EEG: seizure candidates in SzCORE format, scored; spikes by sleep stage; report.",
 "description": "Seizure detection and monitoring on clinical scalp EEG (long-term video-EEG or routine). Prepares the recordings (eeg-prep), detects seizure candidates with a line-length baseline detector or a user-supplied ONNX model and writes them in the SzCORE event format, scored with timescoring (event sensitivity, precision, F1 and false detections per day) against annotated seizures when there are any; stages sleep (YASA) and counts interictal spike candidates per sleep stage; and writes an HTML/PDF report. Detections are candidates for review, with false detections per day always shown next to sensitivity. Research use only.",
 "inputs": [
  {
   "id": "eeg",
   "name": "Scalp EEG recordings",
   "description": "Clinical scalp EEG (routine or long-term): a BIDS-EEG dataset (HED-SCORE seizure events read), or EDF/EDF+, BDF, BrainVision, EEGLAB, FIF, Nihon Kohden or Natus recordings, plus optional CHB-MIT-style summary files or a labels.csv with annotated seizures.",
   "position": {
    "x": 40,
    "y": 300
   }
  }
 ],
 "processors": [
  {
   "id": "prep",
   "type": "processor",
   "sourceUrl": "https://github.com/pennsieve-apps/eeg-prep",
   "tag": "v0.1.0",
   "dependsOn": [
    "eeg"
   ],
   "position": {
    "x": 300,
    "y": 300
   },
   "cpu": "2048",
   "memory": "4096",
   "inputs": []
  },
  {
